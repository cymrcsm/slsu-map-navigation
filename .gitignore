# Node dependencies
node_modules/

# Database files (if generated dynamically by npm run db:init)
*.sqlite
*.db
*.fig

# Local TLS certs for testing live GPS on a phone (never commit private keys)
certs/

# OS files
.DS_Store
Thumbs.db

# docs/: only the .md files are shared (context for the team and for Claude);
# the proposal PDF, manuals, transcripts etc. stay local
docs/*
!docs/*.md

# public static build output (tools/build-web.mjs)
web/

# local override for the public phone-page URL (see docs/WEB-DEPLOY.md)
web-url
